<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.samuelfonseca.tvhome"
    android:versionCode="5"
    android:versionName="1.4">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Album art for the now-playing card, when the playing app only gives a URL. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: everything a launcher can open. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Home"
        android:icon="@drawable/banner"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:largeHeap="false"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Home.Overlay" />

        <!-- Lets the now-playing card see other apps' media sessions. See MediaListener. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="Home now playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Opens Settings from the remote's Settings button. See SettingsKey. -->
        <service
            android:name=".SettingsKey"
            android:exported="true"
            android:label="Home settings button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/settings_key" />
        </service>
    </application>
</manifest>
